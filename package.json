{
  "name": "nts-player",
  "productName": "NTS Player",
  "version": "1.2.0",
  "description": "A small desktop player for NTS Radio: live channels and the archive",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --nts-debug",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "node tests/app.test.js"
  },
  "devDependencies": {
    "d3": "^7.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1"
  },
  "build": {
    "appId": "local.ntsplayer",
    "productName": "NTS Player",
    "files": [
      "main.js",
      "preload.js",
      "art.js",
      "account.js",
      "live-tracks.js",
      "desktop.js",
      "src/**/*",
      "build/icon.png",
      "build/thumb-*.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "NTS-Player-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "NTS-Player-Setup.exe"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "artifactName": "NTS-Player-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "NTS Player"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Desktop player for NTS Radio",
      "maintainer": "NTS Player contributors",
      "artifactName": "NTS-Player-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danielsamson",
        "repo": "nts-player"
      }
    ]
  },
  "homepage": "https://github.com/danielsamson/nts-player",
  "author": "Daniel Samson",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
